# ── Database ──────────────────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App ────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps → New GitHub App
# See GITHUB_APP_SETUP.md for full instructions
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
# Base URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Inngest ───────────────────────────────────────────────────────────────────
# From Inngest dashboard → Your App → Event Key
INNGEST_EVENT_KEY=
# From Inngest dashboard → Your App → Signing Key
INNGEST_SIGNING_KEY=
