# ── Database ──────────────────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string
# Create a free database at https://neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: https://your-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub App ────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps → New GitHub App
# See GITHUB_APP_SETUP.md for full setup instructions.
# Webhook URL: https://your-domain.com/api/webhooks/github
# Required permissions: Pull requests (R/W), Issues (R/W), Contents (R)
# Required events: pull_request, issues, installation, installation_repositories
GITHUB_APP_ID=
GITHUB_APP_NAME=your-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Used for PR summaries, code reviews, and issue triage (model: gpt-4o)
OPENAI_API_KEY=

# ── Auth.js / NextAuth ────────────────────────────────────────────────────────
# Base URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── Inngest ───────────────────────────────────────────────────────────────────
# From Inngest dashboard → Your App → Event Key
# Required in production; optional in local dev (Inngest Dev Server handles it)
INNGEST_EVENT_KEY=
# From Inngest dashboard → Your App → Signing Key
INNGEST_SIGNING_KEY=
